# FindIT PostgreSQL connection string. Keep the real password in environment variables.
# Use Supabase's session pooler (port 5432) for startup migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/postgres?schema=demo_tracker&sslmode=require"

# Long random string used to sign login cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Used ONCE on first boot to create the admin account (when no users exist yet).
ADMIN_NAME="John Truett"
ADMIN_PIN="1234"
