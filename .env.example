# PostgreSQL connection string (Railway provides this as DATABASE_URL)
DATABASE_URL="postgresql://user:password@localhost:5432/demo_tracker"

# Long random string used to sign login cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Used ONCE on first boot to create the admin account (when no users exist yet).
ADMIN_NAME="John Truett"
ADMIN_PIN="1234"
